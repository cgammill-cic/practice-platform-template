{
  "name": "practice-platform",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "schema:manifest": "node scripts/schema-manifest.mjs",
    "schema:check": "node scripts/schema-manifest.mjs --check",
    "db:local": "node scripts/local-db.mjs",
    "migrations:bundle": "node scripts/migrations-bundle.mjs",
    "migrations:check": "node scripts/migrations-bundle.mjs --check",
    "template:scan": "node scripts/template-scan.mjs",
    "template:build": "node scripts/build-template.mjs",
    "check": "npm run typecheck && npm run schema:check && npm run migrations:check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "hono": "^4",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "typescript": "^5",
    "wrangler": "^4"
  }
}
